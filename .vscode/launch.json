  "version": "0.2.0",
  "configurations": [
    {
      "name": "web: ng serve",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "web: start",
      "url": "http://localhost:4200/"
    },
    {
      "name": "server: central --dev",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/server/cmd/central",
      "args": ["serve", "--dev"]
    }
  ]
}
