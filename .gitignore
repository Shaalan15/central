# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files

# ---- Build output ----
/bin/
/dist/
/web/dist/
/web/out-tsc/
/server/internal/webui/dist/*
!/server/internal/webui/dist/.gitkeep
coverage/
*.test
*.out
*.prof

# ---- Node / Angular ----
node_modules/
npm-debug.log*
yarn-error.log
/web/.angular/cache
.sass-cache/
/web/__screenshots__/
/web/test-results/
/web/playwright-report/

# ---- Go ----
/go.work.sum
vendor/

# ---- Local runtime data (never commit secrets) ----
/data/
/.central/
*.pem
*.key
!/docs/**/*.key.example
.env
.env.*
!.env.example

# ---- IDEs and editors ----
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*

# ---- System files ----
.DS_Store
Thumbs.db
